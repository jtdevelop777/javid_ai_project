# 1. Bind ZMQ Sockets ให้เรียบร้อยก่อน (Port 5555 & 8002 Active ทันที)
    var context = zmq.Context()
    var receiver = context.socket(zmq.PULL)
    receiver.bind("tcp://*:5555")
    var publisher = context.socket(zmq.PUB)
    publisher.bind("tcp://*:8002")

    print("📡 ZMQ Receiver Listening on tcp://*:5555")
    print("📡 ZMQ Publisher Listening on tcp://*:8002")

    # 2. ย้ายมาโหลดและสั่งเปิด API Server ตรงนี้
